  },
  "images/questions/logistics/29회-2/q003_r20261113.webp": {
    "kind": "statements",
    "sha256": "a93323cfa188b8435c1c2755107429e64724743b1e1b184f932a9a944f0b32a3",
    "statements": [
      {
        "label": "ㄱ.",
        "text": "두 가지 이상의 운송수단을 연계하여 화물의 환적 기능을 수행한다."
      },
      {
        "label": "ㄴ.",
        "text": "대규모 보관시설과 하역장비를 갖추고 창고·유통가공·포장 등의 물류서비스를 제공한다."
      },
      {
        "label": "ㄷ.",
        "text": "운송정보·재고정보·위치정보 등을 통합 관리하여 운영 효율성을 높인다."
      },
      {
        "label": "ㄹ.",
        "text": "항만 배후지역에만 설치되며 내륙에는 설치되지 않는다."
      },
      {
        "label": "ㅁ.",
        "text": "단일 운송수단만을 이용하여 화물을 목적지까지 직접 운송하는 것이 주된 기능이다."
      }
    ]
  },
  "images/questions/logistics/29회-2/q021_r20261113.webp": {
    "kind": "statements",
    "sha256": "dbcbf5b85b8edce6d46f6f190a30dca716f1f0c56d44cc459b2a5a6d2cdda1cf",
    "statements": [
      {
        "label": "ㄱ.",
        "text": "구매자가 제공하는 판매·재고정보를 바탕으로 공급자가 보충 시점과 수량을 결정하여 구매자의 재고를 관리하는 방식"
      },
      {
        "label": "ㄴ.",
        "text": "생산공정에서 아직 완제품이 되지 않은 상태의 재고"
      },
      {
        "label": "ㄷ.",
        "text": "계절적 수요 증가에 대비하여 미리 확보해 두는 재고"
      }
    ],
    "terms": [
      {
        "label": "A.",
        "text": "재공품 (WIP)"
      },
      {
        "label": "B.",
        "text": "공급자관리재고 (VMI)"
      },
      {
        "label": "C.",
        "text": "안전재고 (Safety Stock)"
      },
      {
        "label": "D.",
        "text": "운송중재고 (In-transit Stock)"
      },
      {
        "label": "E.",
        "text": "예비재고 (Anticipation Stock)"
      }
    ]
  },
