# Django production settings
DJANGO_SECRET_KEY=replace-this-with-a-long-random-production-secret
DJANGO_DEBUG=0

# Render example:
# DJANGO_ALLOWED_HOSTS=your-service-name.onrender.com,your-custom-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service-name.onrender.com,https://your-custom-domain.com
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# HTTPS/proxy settings for Render production
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_PROXY_SSL_HEADER=1
DJANGO_WHITENOISE_MANIFEST_STRICT=0

# 0: all learning features are available to every member (current launch mode)
# 1: enforce the existing free/premium usage limits
DJANGO_PREMIUM_GATING_ENABLED=0

# Separate generated-question watcher process (never runs inside web requests)
DJANGO_GENERATED_MISSION_WATCH_INTERVAL_SECONDS=30

# Optional local Cloudflare Quick Tunnel development access.
# Set only the hostname printed by cloudflared; do not include https:// or a path.
# This is ignored when DJANGO_DEBUG=0 and does not alter Render settings.
DJANGO_TUNNEL_HOST=

# Render PostgreSQL provides this automatically when linked from render.yaml.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Social login OAuth apps (never commit real credentials)
# Callback URLs:
# http://127.0.0.1:8888/accounts/google/login/callback/
# http://127.0.0.1:8888/accounts/naver/login/callback/
# http://127.0.0.1:8888/accounts/kakao/login/callback/
# https://your-domain.com/accounts/google/login/callback/
# https://your-domain.com/accounts/naver/login/callback/
# https://your-domain.com/accounts/kakao/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# GitHub issue watcher
GITHUB_TOKEN=github-personal-access-token
GITHUB_OWNER=github-owner
GITHUB_REPO=github-repository
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
TASKS_PENDING_DIR=automation/tasks/pending
TASKS_PROCESSING_DIR=automation/tasks/processing
TASKS_DONE_DIR=automation/tasks/done
AUTOMATION_STATE_DIR=automation/state
AUTOMATION_ATTACHMENTS_DIR=automation/attachments
AUTOMATION_ATTACHMENT_MAX_BYTES=10485760
ISSUE_POLL_INTERVAL_SECONDS=30
GITHUB_REQUEST_TIMEOUT_SECONDS=15
ISSUE_WATCHER_LOG_LEVEL=INFO

# Codex task worker
# Windows: codex.cmd / Linux and macOS: codex
CODEX_CLI_COMMAND=codex.cmd
CODEX_WORKER_LOGS_DIR=automation/logs
CODEX_TASK_TIMEOUT_SECONDS=1800
CODEX_WORKER_POLL_INTERVAL_SECONDS=5
CODEX_WORKER_LOG_LEVEL=INFO
CODEX_REASONING_EFFORT=high
